<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>eduvixo</AssemblyName>
    <RootNamespace>Eduvixo.Windows</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.2.5</Version>
    <Authors>QUANT Software House</Authors>
    <Company>QUANT Software House</Company>
    <Product>Desktop Client for Windows</Product>
    <Description>Secure online CMS workspace for Windows.</Description>
    <Copyright>Copyright by QUANT Software House.</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\eduvixo-logo.png" />
    <EmbeddedResource Include="lang\*.json" />
  </ItemGroup>

</Project>
